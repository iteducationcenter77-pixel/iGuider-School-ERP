# ============================================
# iGuider School ERP — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file to Git.

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Optional: Supabase Service Role Key ───────
# Only needed for server-side operations (admin tasks).
# Do NOT expose this in the browser.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── App Settings ──────────────────────────────
APP_NAME=iGuider School ERP
APP_ENV=development
